    {
      "id": "stage-1",
      "name": "Foundations",
      "description": "Master drawing fundamentals, writing, and basic character designs.",
      "timeframe": "Stage 1",
      "skills": [
        { "name": "Perspective", "lessons": 10, "progress": 0, "resources": ["Drawabox Lesson 1 & 2", "Andrew Loomis - Creative Illustration"], "exercises": ["1-point and 2-point perspective rooms", "Draw 250 boxes challenge"] },
        { "name": "Anatomy", "lessons": 15, "progress": 0, "resources": ["Proko Anatomy Course", "Bridgman's Life Drawing"], "exercises": ["Gesture drawing (30s, 2m, 5m)", "Draw 50 skull studies"] },
        { "name": "Character Design", "lessons": 8, "progress": 0, "resources": ["Taco - Point Character Drawing", "Marc Brunet Youtube Tutorials"], "exercises": ["Create turnaround sheets for 3 characters", "Expression sheet (12 expressions)"] },
        { "name": "Writing & Storyboard", "lessons": 12, "progress": 0, "resources": ["Scott McCloud - Making Comics", "Will Eisner - Comics and Sequential Art"], "exercises": ["Write a 3-page script", "Thumbnails for a 5-page comic scene"] },
        { "name": "Color Theory & Lighting", "lessons": 6, "progress": 0, "resources": ["Marco Bucci - Color in Storytelling", "James Gurney - Color and Light"], "exercises": ["Paint a value study", "Create 3 distinct mood lighting charts"] }
      ]
    },
    {
      "id": "stage-2",
      "name": "Comic Creation",
      "description": "Produce your first comic pages and master sequential art layouts.",
      "timeframe": "Stage 2",
      "skills": [
        { "name": "Comic Layouts (Panels & Pacing)", "lessons": 8, "progress": 0, "resources": ["Framed Ink: Drawing and Composition", "Scott McCloud - Understanding Comics"], "exercises": ["Plan page layouts for 3 script pages", "Vary panel speeds in a chase scene"] },
        { "name": "Lettering & Bubbles", "lessons": 4, "progress": 0, "resources": ["Comic Lettering Guide", "Blambot fonts"], "exercises": ["Letter 3 pages of dialogue", "Establish dialogue hierarchies"] },
        { "name": "Digital Inking & Coloring", "lessons": 10, "progress": 0, "resources": ["Clip Studio Paint Inking", "Photoshop Digital Coloring"], "exercises": ["Ink a page digitally", "Flat color and shadow rendering on 1 page"] }
      ]
    },
    {
      "id": "stage-3",
      "name": "Audience Growth",
      "description": "Establish your online presence, social marketing, and community building.",
      "timeframe": "Stage 3",
      "skills": [
        { "name": "Social Media (Insta, TikTok, Twitter)", "lessons": 6, "progress": 0, "resources": ["Content Strategy for Creators", "Algorithm breakdown"], "exercises": ["Post 3 times weekly for a month", "Create 3 TikTok speedpaint shorts"] },
        { "name": "Community & Lists (Discord, Newsletters)", "lessons": 5, "progress": 0, "resources": ["MailerLite/Substack setup", "Community management guides"], "exercises": ["Launch personal Discord server", "Create sign-up landing page for newsletter"] }
      ]
    },
    {
      "id": "stage-4",
