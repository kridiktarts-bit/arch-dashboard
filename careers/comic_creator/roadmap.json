        { "name": "Print-on-Demand & Sales (Amazon KDP, Merch)", "lessons": 6, "progress": 0, "resources": ["Amazon KDP publishing guide", "Shopify/Ko-fi print setups"], "exercises": ["Format comic book PDF for KDP print", "List first 3 items in Ko-fi shop"] }
      ]
    },
